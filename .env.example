# Copy to .env (gitignored). Never commit secrets.
# On Render, set these in the dashboard instead. VITE_* are required at build time.
# Do not set TEST_DATABASE_URL on Render. Do not use a local GOOGLE_APPLICATION_CREDENTIALS path.

# --- Firebase web (public client config; still keep out of source) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# --- Firebase Admin (server; never commit the JSON or private key) ---
FIREBASE_PROJECT_ID=
# Preferred locally: path to a service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
# Or inline JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or split fields (private key may use \n for newlines)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

APP_ORIGIN=http://localhost:5173
PORT=3000
# --- Database ---
# Local/dev default: SQLite
DATABASE_PATH=data/app.sqlite
# Production (Neon PostgreSQL). Required when NODE_ENV=production. Never commit a real URL.
DATABASE_URL=
NODE_ENV=development
